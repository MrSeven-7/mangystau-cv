generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SEEKER
  EMPLOYER
  ADMIN
}

enum ApplicationStatus {
  SENT
  VIEWED
  INTERVIEW
  OFFER
  REJECTED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkSchedule {
  FULL_TIME
  PART_TIME
  SHIFT
  ROTATIONAL
  REMOTE
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  refreshTokenHash String?
  role Role
  fullName String
  avatarUrl String? @db.Text
  bannerUrl String? @db.Text
  createdAt DateTime @default(now())
  resumes Resume[]
  applications Application[]
  company Company?
}
model Company {
  id String @id @default(cuid())
  ownerId String @unique
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String
  logoUrl String?
  city String
  description String?
  vacancies Vacancy[]
}
model Industry {
  id Int @id @default(autoincrement())
  slug String @unique
  nameRu String
  nameKk String
  vacancies Vacancy[]
}
model Resume {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  templateId String @default("classic")
  theme Json @default("{\"accent\":\"#147d64\",\"font\":\"Inter\"}")
  data Json
  isPublic Boolean @default(false)
  slug String? @unique
  updatedAt DateTime @updatedAt
  applications Application[]
  @@index([userId])
}
model Vacancy {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industryId Int
  industry Industry @relation(fields: [industryId], references: [id])
  title String
  description String @db.Text
  responsibilities String[] @default([])
  requirements String[] @default([])
  conditions String[] @default([])
  city String
  salary String?
  salaryFrom Int?
  salaryTo Int?
  schedule WorkSchedule
  experience String?
  contactName String?
  contactPhone String?
  contactEmail String?
  moderationStatus ModerationStatus @default(PENDING)
  moderationComment String? @db.Text
  isActive Boolean @default(true)
  publishedAt DateTime @default(now())
  createdAt DateTime @default(now())
  applications Application[]
  @@index([industryId, isActive])
  @@index([moderationStatus])
  @@index([salaryFrom])
}
model Application {
  id String @id @default(cuid())
  vacancyId String
  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  seekerId String
  seeker User @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  resumeId String
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  status ApplicationStatus @default(SENT)
  createdAt DateTime @default(now())
  @@unique([vacancyId, seekerId])
}
